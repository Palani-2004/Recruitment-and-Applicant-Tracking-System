		workflow
		{
		form
		{
			Hide_Subform as "Hide Subform"
			{
				type =  form
				form = Registration_Form

				record event = on add

				field rules
				{
					actions 
					{
						hide Academics;
					}
				}

			}
			Hide_Status as "Hide Status"
			{
				type =  form
				form = Registration_Form

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											enable Gender;
										input.Gender = "Female";
						)
					}
				}

			}
			fill_email as "fill email"
			{
				type =  form
				form = Registration_Form

				record event = on add
					status = inactive

				on user input of Name
				{
					actions 
					{
						custom deluge script
						(
											input.Gmail = input.Name + "@gmail.com";
						)
					}
				}

			}
			fill_Si as "fill Si"
			{
				type =  form
				form = Registration_Form

				record event = on add

				on add row of Projects
				{
					actions 
					{
						custom deluge script
						(
											row.S_No="1";
						)
					}
				}

			}
			alert as "alert"
			{
				type =  form
				form = Registration_Form

				record event = on add
					status = inactive

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Name != null)
										{
											alert "Please Fill the Name";
											cancel submit;
										}
						)
					}
				}

			}
			Applicant_to_Employee as "Applicant to Employee"
			{
				type =  form
				form = Employees1

				record event = on add or edit

				on success
				{
				}

			}
			Applicant_to_Employee1 as "Applicant to Employee"
			{
				type =  form
				form = Application_Status_and_Information_Tracker

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Round_Status == "Selected")
										{
											applicantDetails = Registration_Form[ID = input.Applicant];
											if(applicantDetails.count() > 0)
											{
												existingEmployee = Employees1[Email == applicantDetails.Gmail];
												if(existingEmployee.count() == 0)
												{
													insert into Employees1
													[
														Employee_Name=applicantDetails.Name
														Email=applicantDetails.Gmail
														Phone_Number=applicantDetails.Contact
														Date_of_Joining=zoho.currentdate.addDay(7)
														Added_User=zoho.loginuser
													]
													//applicantDetails.Status = "Hired / Selected";
												}
											}
										}
						)
					}
				}

			}
			First_round_Scheduling as "First round Scheduling"
			{
				type =  form
				form = Registration_Form

				record event = on add or edit

				on success
				{
				}

			}
			Schedule_Status_Updating as "Schedule Status Updating"
			{
				type =  form
				form = Interview_Schedule

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(Interview_Start != null && Interview_End != null)
										{
											input.Schedule_Status = "Scheduled";
										}
										else
										{
											input.Schedule_Status = "Not Scheduled";
										}
										//disable Schedule_Status;
						)
					}
				}

			}
			navigate_to_Next_Intervie as "navigate to Next Interview schedule"
			{
				type =  form
				form = Application_Status_and_Information_Tracker

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											openUrl("#Report:All_Interview_Schedules","same window");
						)
					}
				}

			}
			Round_Status_automation as "Round Status automation"
			{
				type =  form
				form = Application_Status_and_Information_Tracker

				record event = on add or edit

				on user input of Round_Score
				{
					actions 
					{
						custom deluge script
						(
											if(input.Round_Score != null)
										{
											scoreVal = input.Round_Score.toDecimal();
											if(scoreVal >= 7)
											{
												if(input.Interview_Round == 491369000000076011)
												{
													input.Round_Status = "Selected";
												}
												else
												{
													input.Round_Status = "Shortlisted to Next Round";
												}
											}
											else if(scoreVal > 3 && scoreVal < 7)
											{
												input.Round_Status = "On Hold";
											}
											else
											{
												input.Round_Status = "Rejected";
											}
										}
						)
					}
				}

			}
			Previous_round_status_for as "Previous round status for validate button"
			{
				type =  form
				form = Interview_Schedule

				record event = on add or edit

				on user input of Applicant
				{
					actions 
					{
						custom deluge script
						(
											trackerRecord = Application_Status_and_Information_Tracker[Applicant == input.Applicant] sort by Added_Time desc;
										if(trackerRecord.count() > 0)
										{
											input.Previous_Round_Status = trackerRecord.ID;
											/*if(trackerRecord.Round_Status == "Shortlisted to next round")
										    {
										        disable Validate;
										    }
										    else
										    {
										        enable Validate;
										    } */
										}
						)
					}
				}

			}
			Hide_Previous_Round_Statu as "Hide Previous Round Status"
			{
				type =  form
				form = Registration_Form

				record event = on add

				on load
				{
				}

			}
			Hide_Previous_Round_Statu1 as "Hide Previous Round Status"
			{
				type =  form
				form = Interview_Schedule

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											if(input.Round_Name == 491369000000076005)
										{
											hide Previous_Round_Status;
										}
										else
										{
											disable Previous_Round_Status;
										}
										// Hide the schedule status all the time
										hide Schedule_Status;
						)
					}
				}

			}
			Disable_Schedule_Intervie as "Disable Schedule Interview"
			{
				type =  form
				form = Registration_Form

				record event = on add or edit

				on success
				{
				}

			}
			Hide_Schedule_Interview as "Hide Schedule Interview"
			{
				type =  form
				form = Registration_Form

				record event = on add or edit

				on load
				{
				}

			}
		}






		functions
		{
			Validate_Workflow as "Validate Workflow"
			{
				type =  functions
				form = Interview_Schedule
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						openUrl("#Form:Application_Status_and_Information_Tracker?Applicant=" + input.Applicant + "&Interview_Round=" + input.Round_Name,"same window");
					)
					}
				}
			}
			Schedule_1st_round as "Schedule 1st round"
			{
				type =  functions
				form = Registration_Form
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						existingSchedule = Interview_Schedule[Applicant == input.ID && Round_Name == 491369000000076005];
										if(existingSchedule.count() > 0)
										{
											info "Technical Round 1 is already scheduled for this candidate.";
										}
										else
										{
											openUrl("#Form:Interview_Schedule?Applicant=" + input.ID + "&Round_Name=491369000000076005","popup window");
										}
					)
					}
				}
			}
			Schedule_Interview as "Schedule Interview"
			{
				type =  functions
				form = Interview_Schedule
				execution type = for each record	
				on start
				{
					actions  (Schedule_Status != "Scheduled")
					{
					on click
					(
						sched_record = Interview_Schedule[Applicant == input.Applicant && Round_Name == input.Round_Name];
										next_round = input.Round_Name;
										if(sched_record.count() > 0)
										{
											sched_record.Schedule_Status="Scheduled";
											if(input.Round_Name = 491369000000076005)
											{
												next_round = 491369000000076007;
											}
											else if(input.Round_Name = 491369000000076007)
											{
												next_round = 491369000000076009;
											}
											else
											{
												next_round = 491369000000076011;
											}
										}
										openUrl("#Form:Interview_Schedule?Applicant=" + input.Applicant + "&Round_Name=" + next_round,"popup window");
					)
					}
				}
			}
		}
	}
